{
  "name": "argdown-preview",
  "version": "0.1.0",
  "description": "Live Argdown argument-map preview in your browser, driven by a language server for Helix",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "argdown-preview": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@argdown/cli": "^2.0.0",
    "@argdown/language-server": "^2.0.1"
  },
  "devDependencies": {
    "@argdown/core": "^2.0.1",
    "@argdown/map-views": "^2.0.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
